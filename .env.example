BOT_TOKEN=

OWNER_ID=

# Must be an ABSOLUTE path that exactly matches your Railway volume's mount
# point, e.g. if your volume is mounted at /data, set:
# DB_PATH=/data/ragnar_solutions_bot.db
# If left blank, defaults to /data/ragnar_solutions_bot.db.
# If this doesn't match your actual volume mount, your database will be
# wiped on every redeploy even with a volume attached.
DB_PATH=

# Set to true to wipe the database on next boot. Remove or set back to
# false after the reset deploy completes — leaving this true will wipe
# your data on every single deploy.
RESET_DB=